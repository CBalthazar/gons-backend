# Copy to `.env` for local development.
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Postgres (docker-compose default)
DATABASE_URL=postgresql://gons:gons@localhost:5432/gons?schema=public

# Redis (optional for MVP — refresh denylist falls back to DB)
REDIS_URL=redis://localhost:6379

# Auth — CHANGE in production (min 32 chars)
JWT_SECRET=dev-only-change-me-to-32-chars-minimum-0123456789
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=gons.refresh
# Comma-separated allowed origins for CORS (frontend dev server + prod)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Storage — local filesystem by default (uploads/); set S3_* to use MinIO/R2/S3
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:3000
MAX_MODEL_BYTES=52428800
# S3/MinIO (docker-compose minio:9000, console:9001)
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-1
S3_BUCKET=gons-models
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Signed download TTL (seconds)
SIGNED_URL_TTL=60
