{
  "name": "gons-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:up": "docker compose up -d postgres redis minio",
    "openapi": "tsx src/scripts/dump-openapi.ts"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.880.0",
    "@aws-sdk/s3-request-presigner": "^3.880.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.0",
    "@prisma/client": "^6.16.0",
    "argon2": "^0.44.0",
    "fastify": "^5.6.1",
    "jose": "^6.0.13",
    "pino": "^9.9.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "prisma": "^6.16.0",
    "supertest": "^7.1.4",
    "@types/supertest": "^6.0.3",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
